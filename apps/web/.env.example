# Web Application Environment Variables (.env.example)

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project credentials from P00 / P01)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Media Storage (Cloudflare R2)
NEXT_PUBLIC_MEDIA_DOMAIN=media.yourdomain.com
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=growthos-media-staging

# Security (Cloudflare Turnstile)
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=


# Turnstile site key used by the browser widget (Cloudflare dummy: 1x00000000000000000000AA always passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Set to "true" once the Google provider is enabled in Supabase Auth
NEXT_PUBLIC_GOOGLE_AUTH=false

# Connection string for the job queue (the web server only sends jobs; the worker runs them).
# Local Supabase: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=
